CUDA_DEVICE_ID=0
EVAL_CUDA_DEVICE_ID=0
# Optional: make CUDA_VISIBLE_DEVICES numbering stable across mixed GPU systems.
# If set to PCI_BUS_ID on a 5090+4090 box, re-check which visible ID maps to
# each GPU before launching long runs.
# CUDA_DEVICE_ORDER=PCI_BUS_ID

CHESS_SFT_OUTPUT_HOST=../../.runtime/chess_sft_data
CHESS_SFT_CHECKPOINTS_HOST=../../.runtime/chess_sft_checkpoints
HF_CACHE_HOST=../../.runtime/hf_cache
WANDB_HOST_DIR=../../.runtime/wandb
CHESS_SFT_BASE_MODEL=Qwen/Qwen3.5-0.8B
STOCKFISH_PATH=/usr/games/stockfish
# Auto mode keeps the real-run default on SDPA unless you opt into the pinned
# kernels-community FlashAttention 2 packed/padding-free path.
# CHESS_SFT_ENABLE_HF_FLASH_ATTN2_AUTO=1
# CHESS_SFT_DISABLE_HF_FLASH_ATTN2_AUTO=1
# Keep unset for real runs unless FlashAttention 4 model-load smoke passes.
# CHESS_SFT_ENABLE_FLASH_ATTENTION_4_AUTO=1

# vLLM 0.24 V2 runner can require UVA that is unavailable under some WSL GPU
# setups. Use the V1 model runner for sidecar eval when smoke tests show
# "RuntimeError: UVA is not available".
# VLLM_USE_V2_MODEL_RUNNER=0
# VLLM_WORKER_MULTIPROC_METHOD=spawn
# VLLM_ENABLE_V1_MULTIPROCESSING=1
# VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

WSL_REPO_PATH=/path/to/wsl/chess_sft_sdpo
WSL_DATA_ROOT=/path/to/persistent/chess_sft_data
WSL_CHECKPOINT_ROOT=/path/to/persistent/chess_sft_checkpoints
WSL_HF_CACHE=/path/to/persistent/chess_sft_hf_cache
WSL_WANDB_DIR=/path/to/persistent/chess_sft_wandb
WSL_STOCKFISH_PATH=stockfish
# WSL_VENV_PATH=/path/to/wsl/chess_sft_sdpo/.venv
# WSL_CONDA_ENV=chess-sft-wsl

BASE_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
EVAL_BASE_IMAGE=vllm/vllm-openai:latest
INSTALL_VLLM=0
INSTALL_QWEN_FAST_PATH=1
FLASH_LINEAR_ATTENTION_VERSION=0.5.1
CAUSAL_CONV1D_VERSION=1.6.2.post1
INSTALL_FLASH_ATTN=1
FLASH_ATTN_WHEEL_URL=https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3%2Bcu12torch2.8cxx11abiTRUE-cp311-cp311-linux_x86_64.whl

# Optional runtime auth:
HF_TOKEN=
WANDB_API_KEY=
# Full runs reject offline W&B unless --allow-wandb-offline is passed.
# WANDB_MODE=offline
# WANDB_ENTITY=
# WANDB_BASE_URL=
